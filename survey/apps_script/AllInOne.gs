function applyPage_(cat) {
  // 画面の部品は、その区分で使うものだけを埋め込む(他の区分の文言を、ページに含めない)
  var ext = cat === 'corp' ? corpPersons_.toString() + corpAddCount_.toString() + ';' : (cat === 'career' ? extraPersons_.toString() + extraCountC_.toString() + ';' : '');
  return APPLY_HTML.replace('__DATA__', function () { return safeJson_(publicSiteData_(cat)); }).replace('__EXT__', function () { return ext; });
}

/** 申込を名簿に登録し、受付確認メール(お振込先つき)を申込者に、新規申込の通知を運営に送る(フォーム・専用サイトの共通処理) */
function finishApplication_(reg, category, res, tsIso) {
  reg.getSheetByName(SHEETS.roster).appendRow(res.row);
  var mail = buildApplyReceiptEmail_(res, category);
  var result = '送信済み';
  try { sendMail_(res.email, mail.subject, mail.body, mail.html); } catch (err) { result = '【送信失敗】' + err; }
  var label = CATEGORY_LABEL[category];
  reg.getSheetByName(SHEETS.sendlog).appendRow([tsIso, res.id, '申込受付(' + label + ')', res.email, result]);
  var op = opMail_(reg);
  var who = category === 'corp' ? res.company + ' / 担当:' + res.name + ' / ' + (res.plan ? res.plan.label : '') : (category === 'career' ? '申込者:' + res.name + ' / お子様:' + res.childName : res.name);
  var t0note = category === 'career' ? autoSendT0OnApply_(reg, res.id) : '';
  if (op) sendMail_(op, '[調査アンケート] 新しい申込がありました(' + label + ' / ' + res.id + ')', res.id + ' / ' + who + (t0note ? '\n' + t0note : '') + '\n日程調整のうえ、名簿の「受講日」を入力してください。\n' + reg.getUrl());
  return result;
}

/** 親子プランの申込の直後に、受講前アンケート(T0)の案内を、自動で送る。送ったときは、運営への通知に載せる文を返す。送れなかったときは、送信ログに理由を残す(申込自体は、そのまま受け付ける) */
function autoSendT0OnApply_(reg, id) {
  try {
    var sch = getSchedule_(reg);
    if (!sch.enabled || !sch.t0OnApply) return '';
    var fam = readRoster_(reg).filter(function (f) { return f.id === id; })[0];
    if (!fam || (fam.sent && fam.sent.T0)) return '';
    if (MailApp.getRemainingDailyQuota() < 1) throw new Error('今日の送信上限に足りません');
    requireSurveySiteUrl_(reg);
    var r = sendLinksToFamilies_(reg, 'T0', [fam]);
    return r.ok ? '受講前アンケート(T0)の案内を、申込者に自動で送りました。' : '受講前アンケート(T0)の案内の自動送信に失敗しました(「送信ログ」を確認してください)。';
  } catch (e) {
    reg.getSheetByName(SHEETS.sendlog).appendRow([nowStr_(), id, 'T0 自動送信(申込直後)', '', '【送信せず】' + (e && e.message ? e.message : e)]);
    return '受講前アンケート(T0)の案内は、自動では送れませんでした(' + (e && e.message ? e.message : e) + ')。';
  }
}

/** 専用サイトからの申込(誰でも呼べる)。入力を確認し、問題があれば修正点を返し、問題なければ登録して、お振込先を返す */
function submitApplication(category, answers, honeypot) {
  if (['career', 'general', 'corp'].indexOf(category) === -1) throw new Error('区分が正しくありません');
  if (honeypot) return { ok: true, silent: true };
  var clean = sanitizeAnswers_(category, answers);
  var cache = CacheService.getScriptCache();
  if (rateLimited_(cache, 'apply_all_' + Math.floor(Date.now() / 60000), 40, 120)) return { ok: false, errors: ['ただいま、混み合っています。しばらくしてから、もう一度お試しください'] };
  var emailKey = String(clean.AP2 || clean.GE4 || clean.CO4 || '').toLowerCase();
  if (emailKey && rateLimited_(cache, 'apply_mail_' + emailKey.slice(0, 80), 5, 3600)) return { ok: false, errors: ['同じメールアドレスからの送信が多すぎます。しばらくしてから、もう一度お試しください'] };
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var reg = regSS_();
    var existing = readRoster_(reg).map(function (r) { return { id: r.id, email: r.email, childName: r.childName, name: r.name, company: r.company, category: r.category }; });
    var tsIso = nowStr_();
    var res = processApplication_(answersToNamedValues_(category, clean), existing, tsIso, category);
    if (!res.ok) return { ok: false, errors: friendlyReasons_(res.reason) };
    finishApplication_(reg, category, res, tsIso);
    var plan = res.plan || null;
    return { ok: true, fee: feeLines_(category, plan, res.extra || null), bank: bankLines_(), line: LINE_URL, email: res.email };
  } finally {
    lock.releaseLock();
  }
}

