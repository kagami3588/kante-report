  { key: 'career', def: 'apply', label: '親子プラン', sub: '申込者とお子様の、お申込み', desc: 'お子様の進路・自己理解のための本プログラムです。調査アンケートへのご協力をお願いしています。', fee: '鑑定料 30,000円' },
