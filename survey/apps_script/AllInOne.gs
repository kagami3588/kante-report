  var t = T[time + '_parent'];
  var v = templateVars_(isSurvey ? time : '', 'parent', p, urls && urls.parent);
  return { parent: { subject: renderTemplate_(t.subject, v), body: renderTemplate_(t.body, v).replace(/\n{3,}/g, '\n\n') } };
}

