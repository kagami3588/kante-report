/** アンケートサイトのURL(設定シートB7)。空欄なら、Googleフォームのリンクを使う */
function surveySiteUrl_(reg) { return String(reg.getSheetByName(SHEETS.settings).getRange('B7').getValue() || '').trim(); }

/** アンケートサイトのURL(設定B7)を返す。未入力・形式が違うときは、メールを送る前に、理由を知らせて止める */
function requireSurveySiteUrl_(reg) {
  var u = surveySiteUrl_(reg);
  if (!u) throw new Error('台帳の「設定」シートのB7に、アンケートサイトのURLが入力されていません。公開用URLの末尾に ?page=survey を付けたものを入力してから、もう一度送ってください(未入力のため、メールは送っていません)');
  if (!/^https:\/\/[^\s]+\?page=survey$/.test(u)) throw new Error('設定B7のURLの形式が正しくありません。「https://…/exec?page=survey」の形で、スペースや改行を入れずに入力してください(現在の値: ' + u.slice(0, 80) + ')');
  return u;
}

function surveyFormKey_(role, time) { return (role === 'child' ? 'CT' : (role === 'partner' ? 'PP' : 'PT')) + time.charAt(1); }

/** 申込者のメールアドレスに一致する、進路相談の家庭(辞退・削除済みを除く)。同じアドレスで、お子様の回答もできる */
function surveyFamiliesFor_(roster, email) {
  var e = String(email || '').trim().toLowerCase();
  if (!e) return [];
  return roster.filter(function (f) {
    return f.category === 'career' && f.status !== '辞退' && f.status !== '削除済み' && String(f.email || '').trim().toLowerCase() === e;
  });
}

/** 家庭ごとの、回答者(申込者・お子様)の選択肢と状態。state: 'due'(いま答えられる) 'done'(回答済み) 'wait'(まだ案内がない) */
function surveyOptions_(families, answered) {
  var out = [];
  families.forEach(function (f) {
    ['parent', 'child', 'partner'].forEach(function (role) {
      if (role === 'partner' && f.partnerJoin !== 'はい') return;
      var due = surveyDue_(f, role, answered);
      var label = role === 'parent' ? '申込者(' + givenName_(f.name) + ' 様)' : (role === 'child' ? 'お子様(' + givenName_(f.childName) + ' さん)' : 'パートナーの方(' + givenName_(f.partnerName) + ' 様)');
      var opt = { id: f.id, role: role, label: label, state: due.state, time: due.time || '', form: due.key || '' };
      // 回答済みの方は、いまの時期の間、回答を修正できる(次の時期の案内を送ると、表示も修正もできなくなる)
      if (due.state === 'done') { opt.canEdit = true; opt.editForm = due.key; opt.editTime = due.time; }
      out.push(opt);
    });
  });
  return out;
}

/**
 * その家庭・役割の、いまの時期(案内を送った、いちばん新しい時期)のアンケートの状態。
 * 'due'=答えられる / 'done'=回答済み(この時期の間は、修正できる) / 'wait'=まだ案内がない。
 * 次の時期の案内を送ると、前の時期のアンケートは、表示も修正もできなくなる
 */
function surveyDue_(fam, role, answered) {
  var cur = null;
  for (var i = 0; i < LINK_TIMES.length; i++) if (fam.sent && fam.sent[LINK_TIMES[i]]) cur = LINK_TIMES[i];
  if (!cur) return { state: 'wait' };
  var key = surveyFormKey_(role, cur);
  return answered[fam.id + '|' + key] ? { state: 'done', key: key, time: cur } : { state: 'due', key: key, time: cur };
}

/** 設問の文に入れるお名前。other=相手(申込者には、パートナー。パートナーには、申込者)。partner=パートナーが参加するか */
function nameVars_(fam, role) {
  var isP = role === 'partner';
  return { child: fam.childName, parent: fam.name, other: isP ? fam.name : fam.partnerName, otherLabel: isP ? '申込者の方' : 'パートナーの方', partner: fam.partnerJoin === 'はい' };
}

/** 画面に渡す設問の定義。区分の記号(A.など)は外す。調査用IDは画面には出さない(サーバーで付ける) */
function surveyClientDef_(key, vars) {
  vars = vars || {};
  var d = SURVEY.forms[key];
  var rn = function (x) { return renderNames_(x, vars); };
  return {
    key: key, role: d.role, title: d.title, intro: rn(d.intro),
    blocks: d.blocks.filter(function (b) { return !(b.type === 'q' && b.kind === 'id') && !(b.partnerOnly && !vars.partner); }).map(function (b) {
      if (b.type === 'page') return { type: 'page', title: rn(String(b.title)).replace(/^[A-Z](-[0-9]+)?\.\s*/, ''), desc: rn(b.desc || ''), conditional: !!b.conditional };
      return { type: 'q', id: b.id, text: rn(b.text), kind: b.kind, required: isReq_(d, b), choices: choicesOf_(b), exclusive: b.exclusive || '', hiddenWhen: b.hiddenWhen || null, showIfChosen: b.showIfChosen || null, inline: !!b.inline, gate: b.gate || null, note: b.note || '' };
    })
  };
}

/** 画面から届いた回答を整える(知らない設問は捨て、選択肢にないものは空にし、長さを制限する)。調査用IDを付けた、フォームと同じ形(設問の題名→[値])にして返す */
function sanitizeSurveyAnswers_(key, rid, answers) {
  var nv = {};
  answers = answers || {};
  questionsOf_(key).forEach(function (q) {
    var v = answers[q.id];
    if (q.kind === 'id') { nv[qTitle_(q)] = [rid]; return; }
    var out = '';
    if (q.kind === 'multi') {
      var chosen = (Array.isArray(v) ? v : []).map(String).filter(function (x) { return (choicesOf_(q) || []).indexOf(x) !== -1; });
      if (q.exclusive && chosen.indexOf(q.exclusive) !== -1) chosen = [q.exclusive];
      out = chosen.join(', ');
    } else if (q.kind === 'single') {
      v = (v === undefined || v === null) ? '' : String(v);
      out = (choicesOf_(q) || []).indexOf(v) !== -1 ? v : '';
    } else if (q.kind === 'age') {
      v = (v === undefined || v === null) ? '' : String(v).trim();
      out = /^[0-9]{1,2}$/.test(v) ? v : '';
    } else {
      v = (v === undefined || v === null) ? '' : String(v).replace(/\u0000/g, '').trim();
      out = v.slice(0, 3000);
    }
    nv[qTitle_(q)] = [out];
  });
  return nv;
}

/** 必須の設問(分岐で非表示のものを除く)に、未回答がないか。あれば、その設問の文を返す */
function surveyMissing_(key, answers, hasPartner) {
  answers = answers || {};
  var d = SURVEY.forms[key], miss = null;
  questionsOf_(key).forEach(function (q) {
    if (miss || q.kind === 'id' || !isReq_(d, q) || (q.partnerOnly && !hasPartner)) return;
    if (isHiddenQ_(q, answers)) return;
    var v = answers[q.id];
    var empty = q.kind === 'multi' ? !(Array.isArray(v) && v.length) : (v === undefined || v === null || String(v).trim() === '');
    if (empty) miss = q.text;
  });
  return miss;
}

/** 回答済みのアンケートの、前回の回答(設問ID → 値。複数選択は配列)。申込者の修正用 */
function surveyPrior_(db, id, key) {
  var vals = db.getSheetByName(SHEETS.long).getDataRange().getValues();
  var head = vals.shift(), ix = {};
  head.forEach(function (h, i) { ix[h] = i; });
  var kinds = {};
  questionsOf_(key).forEach(function (q) { kinds[q.id] = q.kind; });
  var out = {};
  vals.forEach(function (r) {
    if (String(r[ix['調査用ID']]) !== id || String(r[ix['フォームID']]) !== key || !isTrue_(r[ix['分析採用']]) || r[ix['状態']] !== '回答') return;
    var qid = String(r[ix['設問ID']]), v = String(r[ix['回答内容']]);
    out[qid] = kinds[qid] === 'multi' ? v.split(', ').filter(function (x) { return x !== ''; }) : v;
  });
  return out;
}

/** 修正のため、そのフォーム・家庭の、前回の回答の行(Submissions・Long・LongOptions)を消す */
function dropSubmissionRows_(db, id, key) {
  var sub = db.getSheetByName(SHEETS.submissions).getDataRange().getValues();
  var sids = {};
  for (var i = 1; i < sub.length; i++) if (String(sub[i][2]) === id && String(sub[i][4]) === key) sids[String(sub[i][0])] = true;
  [SHEETS.submissions, SHEETS.long, SHEETS.options].forEach(function (name) {
    var sh = db.getSheetByName(name);
    var vals = sh.getDataRange().getValues();
    var kept = [vals[0]].concat(vals.slice(1).filter(function (r) { return !sids[String(r[0])]; }));
    if (kept.length === vals.length) return;
    sh.clearContents();
    sh.getRange(1, 1, kept.length, kept[0].length).setValues(kept);
  });
}

function surveyAnswered_(db) {
  var sub = db.getSheetByName(SHEETS.submissions), prior = {};
  if (sub && sub.getLastRow() > 1) sub.getRange(2, 3, sub.getLastRow() - 1, 3).getValues().forEach(function (r) { prior[r[0] + '|' + r[2]] = true; });
  return prior;
}

/** メールアドレス(申込者のもの)での入室(誰でも呼べる)。回答者(申込者・お子様)の選択肢と、送信用の合い鍵(6時間有効)を返す */
function surveyLogin(email) {
  var generic = { ok: false, message: 'このメールアドレスでは、いま答えられるアンケートが見つかりません。申込のときに登録した、申込者のメールアドレスを、ご確認ください。ご案内のメールが届いていない場合は、' + CONTACT_MAIL + ' までご連絡ください。' };
  email = String(email || '').trim().toLowerCase().slice(0, 200);
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return { ok: false, message: 'メールアドレスの形式が正しくありません。' };
  var cache = CacheService.getScriptCache();
  if (rateLimited_(cache, 'sv_login_all_' + Math.floor(Date.now() / 600000), 300, 700)) return { ok: false, message: 'ただいま、混み合っています。しばらくしてから、もう一度お試しください。' };
  if (rateLimited_(cache, 'sv_login_' + email, 10, 3600)) return { ok: false, message: '短い時間に、何度も試されました。しばらくしてから、もう一度お試しください。' };
  var reg = regSS_(), db = dbSS_();
  var fams = surveyFamiliesFor_(readRoster_(reg), email);
  var options = surveyOptions_(fams, surveyAnswered_(db));
  if (!options.some(function (o) { return o.state === 'due' || o.canEdit; })) {
    if (options.some(function (o) { return o.state === 'done'; })) return { ok: false, done: true, message: 'ご回答ありがとうございます。いま答えていただくアンケートは、ありません。次のアンケートの準備ができたら、メールでご案内します。' };
    return generic;
  }
  var token = Utilities.getUuid().replace(/-/g, '') + Utilities.getUuid().replace(/-/g, '');
  cache.put('sv_tok_' + token, JSON.stringify({ email: email }), 21600);
  return { ok: true, token: token, options: options };
}

/** 回答者(申込者・お子様)を選んで、そのアンケートを始める(合い鍵が必要)。同じメールアドレスの中で、切り替えられる */
function surveyStart(token, id, role, edit) {
  token = String(token || '');
  var cache = CacheService.getScriptCache();
  var raw = /^[0-9a-f]{64}$/.test(token) ? cache.get('sv_tok_' + token) : null;
  if (!raw) return { ok: false, expired: true, message: '時間がたったため、最初からやり直してください。メールアドレスの入力画面にもどります。' };
  var sess = JSON.parse(raw);
  if (role !== 'parent' && role !== 'child' && role !== 'partner') return { ok: false, message: '回答者を選んでください。' };
  var reg = regSS_(), db = dbSS_();
  var fams = surveyFamiliesFor_(readRoster_(reg), sess.email).filter(function (f) { return f.id === String(id); });
  if (!fams.length) return { ok: false, message: '回答者が見つかりません。' };
  if (role === 'partner' && fams[0].partnerJoin !== 'はい') return { ok: false, message: '回答者が見つかりません。' };
  var ansd = surveyAnswered_(db);
  if (edit) {
    // 回答の修正: いまの時期のアンケートに、回答済みの方だけ。次の時期の案内を送ったあとは、前の時期の回答は、開けない
    var cd = surveyDue_(fams[0], role, ansd);
    if (cd.state !== 'done') return { ok: false, message: '修正できる回答が、ありません(次のアンケートの時期に進んだ場合は、前の回答は、表示も修正もできません)。' };
    sess.cur = { id: fams[0].id, role: role, key: cd.key, edit: true };
    cache.put('sv_tok_' + token, JSON.stringify(sess), 21600);
    return { ok: true, edit: true, who: givenName_(role === 'child' ? fams[0].childName : (role === 'partner' ? fams[0].partnerName : fams[0].name)), prior: surveyPrior_(db, fams[0].id, cd.key), def: surveyClientDef_(cd.key, nameVars_(fams[0], role)) };
  }
  var due = surveyDue_(fams[0], role, ansd);
  if (due.state !== 'due') return { ok: false, done: true, message: 'この方のアンケートは、いま、答えられるものがありません。' };
  sess.cur = { id: fams[0].id, role: role, key: due.key };
  cache.put('sv_tok_' + token, JSON.stringify(sess), 21600);
  return { ok: true, who: givenName_(role === 'child' ? fams[0].childName : (role === 'partner' ? fams[0].partnerName : fams[0].name)), def: surveyClientDef_(due.key, nameVars_(fams[0], role)) };
}

function maskEmail_(e) {
  e = String(e || '');
  var at = e.indexOf('@');
  return at < 1 ? (e ? '(形式が不正)' : '(空)') : e.charAt(0) + '***' + e.slice(at);
}

/** アンケートサイトに入れない原因を調べる(診断用)。サイトが見ている台帳・回答DBのURLと、進路相談の各家庭の状況を、実行ログに出す。メールアドレスは一部を伏せる */
function diagnoseSurvey() {
  ownerOnly_();
  var reg = regSS_(), db = dbSS_();
  var lines = ['サイトが見ている台帳: ' + reg.getUrl(), 'サイトが見ている回答DB: ' + db.getUrl(), 'アンケートサイトのURL(設定B7): ' + (surveySiteUrl_(reg) || '(未設定。案内メールにはGoogleフォームのリンクが載ります)')];
  var roster = readRoster_(reg), answered = surveyAnswered_(db);
  lines.push('名簿の行数: ' + roster.length);
  roster.forEach(function (f) {
    var why = [];
    if (f.category !== 'career') why.push('区分が進路相談ではない(' + (f.category || '空') + ')→ アンケートの対象外');
    if (!isParticipating_(f.status)) why.push('参加状況が「' + f.status + '」');
    var due = surveyDue_(f, 'parent', answered);
    if (f.category === 'career') {
      if (due.state === 'wait') why.push('案内(T0)をまだ送っていない → 管理画面で「T0のリンクを送る」');
      else if (due.state === 'done') why.push('案内済みのアンケートには、すべて回答済み');
      else why.push('入室できる状態です(いまのアンケート: ' + due.key.replace(/^P/, '申込者用 ').replace(/^C/, 'お子様用 ') + ')');
    }
    lines.push(f.id + ' / 区分:' + (f.category || '空') + ' / 参加状況:' + f.status + ' / 申込者:' + maskEmail_(f.email) +
      ' / 案内の送信 T0:' + (f.sent && f.sent.T0 ? '済' : '未') + ' T1:' + (f.sent && f.sent.T1 ? '済' : '未') + ' T2:' + (f.sent && f.sent.T2 ? '済' : '未') + ' → ' + why.join(' / '));
  });
  Logger.log(lines.join('\n'));
}

/** アンケートの送信(誰でも呼べるが、入室で渡した合い鍵と、回答者の選択が必要)。フォームと同じ処理で、回答DBに記録する。送信後は、回答者の選択肢を、最新にして返す */
function surveySubmit(token, answers) {
  token = String(token || '');
  var cache = CacheService.getScriptCache();
  var raw = /^[0-9a-f]{64}$/.test(token) ? cache.get('sv_tok_' + token) : null;
  if (!raw) return { ok: false, message: '時間がたったため、最初からやり直してください。メールアドレスの入力画面にもどります。', expired: true };
  var sess = JSON.parse(raw);
  if (!sess.cur) return { ok: false, message: '回答者を選んでから、始めてください。' };
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var reg = regSS_(), db = dbSS_();
    var roster = readRoster_(reg);
    var fam = roster.filter(function (f) { return f.id === sess.cur.id; })[0] || { id: sess.cur.id, sent: {} };
    var due = surveyDue_(fam, sess.cur.role, surveyAnswered_(db));
    if (sess.cur.edit) {
      if (due.state !== 'done' || due.key !== sess.cur.key) { delete sess.cur; cache.put('sv_tok_' + token, JSON.stringify(sess), 21600); return { ok: false, message: '次のアンケートの時期に進んだため、この回答は、修正できません。', done: true }; }
      var missingE = surveyMissing_(sess.cur.key, answers, fam.partnerJoin === 'はい');
      if (missingE) return { ok: false, message: 'まだ答えていない質問があります。すべての質問に、ご回答をお願いします。(' + missingE.slice(0, 40) + ')' };
      dropSubmissionRows_(db, sess.cur.id, sess.cur.key);
      recordSubmission_(db, reg, sess.cur.key, sanitizeSurveyAnswers_(sess.cur.key, sess.cur.id, answers));
      delete sess.cur;
      cache.put('sv_tok_' + token, JSON.stringify(sess), 21600);
      return { ok: true, edited: true, options: surveyOptions_(surveyFamiliesFor_(readRoster_(reg), sess.email), surveyAnswered_(db)) };
    }
    if (due.state !== 'due' || due.key !== sess.cur.key) { delete sess.cur; cache.put('sv_tok_' + token, JSON.stringify(sess), 21600); return { ok: false, message: 'このアンケートには、すでにご回答いただいています。ありがとうございました。', done: true }; }
    var missing = surveyMissing_(sess.cur.key, answers, fam.partnerJoin === 'はい');
    if (missing) return { ok: false, message: 'まだ答えていない質問があります。すべての質問に、ご回答をお願いします。(' + missing.slice(0, 40) + ')' };
    recordSubmission_(db, reg, sess.cur.key, sanitizeSurveyAnswers_(sess.cur.key, sess.cur.id, answers));
    delete sess.cur;
    cache.put('sv_tok_' + token, JSON.stringify(sess), 21600);
    var options = surveyOptions_(surveyFamiliesFor_(readRoster_(reg), sess.email), surveyAnswered_(db));
    return { ok: true, options: options };
  } finally {
    lock.releaseLock();
  }
}

/** アンケートの画面(ブラウザで動く)。toString で、ページに埋め込む。外の変数は SURVEY_SITE と google のみ */
function surveyClient_() {
  var el = function (t, c, x) { var e = document.createElement(t); if (c) e.className = c; if (x !== undefined) e.textContent = x; return e; };
  var app = document.getElementById('app');
  var state = { token: '', def: null, ans: {}, pages: [], idx: 0 };

  function qs() { return state.def.blocks.filter(function (b) { return b.type === 'q'; }); }
  /** 設問が「非表示」になるか(前の設問の答えによる分岐) */
  function hidden(q) { if (q.showIfChosen) { var ch = state.ans[q.showIfChosen.id]; return !(ch && ch.indexOf(q.showIfChosen.value) !== -1); } if (!q.hiddenWhen) return false; var v = state.ans[q.hiddenWhen.id]; if (q.inline && (v === undefined || v === '')) return true; return v === q.hiddenWhen.value; }
  /** 画面のページ(ページ区切りごとの設問のまとまり)。先頭に区切りがない設問は、最初のページ */
  function buildPages(def) {
    var pages = [], cur = null;
    def.blocks.forEach(function (b) {
      if (b.type === 'page') { cur = { title: b.title, desc: b.desc, conditional: b.conditional, qs: [] }; pages.push(cur); return; }
      if (!cur) { cur = { title: '', desc: '', conditional: false, qs: [] }; pages.push(cur); }
      cur.qs.push(b);
    });
    return pages;
  }
  function shownPages() { return state.pages.filter(function (p) { return p.qs.some(function (q) { return !hidden(q); }); }); }

  function login() {
    app.innerHTML = '';
    var c = el('div', 'card');
    c.appendChild(el('h2', '', 'アンケートのページ'));
    c.appendChild(el('div', 'desc', 'お申込みのときに登録した、申込者のメールアドレスを入力してください。申込者と、お子様の、いま答えていただくアンケートが選べます。'));
    var q = el('div', 'q');
    q.appendChild(el('label', 't', 'メールアドレス'));
    var inp = document.createElement('input'); inp.type = 'email'; inp.autocomplete = 'email'; q.appendChild(inp);
    var msg = el('div', 'banner'); q.appendChild(msg);
    c.appendChild(q);
    var btn = el('button', 'btn', 'はじめる'); btn.type = 'button'; c.appendChild(btn);
    app.appendChild(c);
    function go() {
      if (!inp.value.trim()) { msg.style.display = 'block'; msg.textContent = 'メールアドレスを入力してください。'; return; }
      btn.disabled = true; btn.textContent = '確認しています…'; msg.style.display = 'none';
      google.script.run.withSuccessHandler(function (r) {
        btn.disabled = false; btn.textContent = 'はじめる';
        if (!r || !r.ok) { msg.style.display = 'block'; msg.textContent = (r && r.message) || 'うまくいきませんでした。'; return; }
        state.token = r.token; chooser(r.options, '');
      }).withFailureHandler(function () {
        btn.disabled = false; btn.textContent = 'はじめる'; msg.style.display = 'block'; msg.textContent = '通信できませんでした。もう一度お試しください。';
      }).surveyLogin(inp.value);
    }
    btn.onclick = go;
    inp.onkeydown = function (e) { if (e.key === 'Enter') go(); };
  }

  /** 回答者(申込者・お子様)の選択。同じメールアドレスのまま、切り替えられる */
  function chooser(options, thanks) {
    app.innerHTML = '';
    var c = el('div', 'card');
    if (thanks) { c.appendChild(el('div', 'ok', '✓')); c.appendChild(el('h2', '', thanks)); }
    else c.appendChild(el('h2', '', '回答する方を選んでください'));
    var left = options.filter(function (o) { return o.state === 'due'; });
    c.appendChild(el('div', 'desc', left.length ? '申込者と、お子様の、アンケートがあります。このページのリンクと、ご登録のメールアドレスをご家族に共有すると、それぞれの携帯から、回答できます。お子様のアンケートは、お子様ご本人に、お答えいただいてください(申込者の方は、お子様の回答を、見たり、聞き出したりしないでください)。' : 'すべてのアンケートに、ご回答いただきました。ありがとうございました。回答は、このまま修正もできます。次のアンケートの案内が届くと、前の回答は、表示も修正もできなくなります。'));
    options.forEach(function (o) {
      var row = el('div', 'who');
      row.appendChild(el('div', 'whoname', o.label));
      if (o.state === 'due') {
        var b = el('button', 'btn', (o.time === 'T0' ? '受講前' : o.time === 'T1' ? '受講後' : '受講から約3か月後') + 'のアンケートに回答する'); b.type = 'button';
        b.onclick = function () { begin(o, b); };
        row.appendChild(b);
      } else {
        row.appendChild(el('div', 'whostate', o.state === 'done' ? '回答済み' : 'まだ、ご案内がありません'));
        if (o.canEdit) {
          var eb = el('button', 'btn ghost', '回答を修正する'); eb.type = 'button';
          eb.onclick = function () { begin(o, eb, true); };
          row.appendChild(eb);
        }
      }
      c.appendChild(row);
    });
    app.appendChild(c); window.scrollTo(0, 0);
  }

  function begin(o, btn, edit) {
    btn.disabled = true;
    google.script.run.withSuccessHandler(function (r) {
      btn.disabled = false;
      if (r && r.ok && r.edit) { state.def = r.def; state.ans = r.prior || {}; state.pages = buildPages(r.def); state.idx = 0; state.editing = true; show(); return; }
      if (r && r.ok) { state.def = r.def; state.ans = {}; state.pages = buildPages(r.def); state.idx = 0; state.editing = false; intro(r.who); return; }
      if (r && r.expired) { alert(r.message); return login(); }
      alert((r && r.message) || '始められませんでした。');
    }).withFailureHandler(function () { btn.disabled = false; alert('通信できませんでした。もう一度お試しください。'); }).surveyStart(state.token, o.id, o.role, !!edit);
  }

  function intro(who) {
    app.innerHTML = '';
    var c = el('div', 'card');
    c.appendChild(el('h2', '', state.def.title));
    if (who) c.appendChild(el('div', 'desc', who + (state.def.role === 'child' ? ' さん' : ' 様') + '、こんにちは。'));
    c.appendChild(el('div', 'desc', state.def.intro));
    var btn = el('button', 'btn', 'アンケートをはじめる'); btn.type = 'button'; c.appendChild(btn);
    app.appendChild(c);
    btn.onclick = function () { state.idx = 0; show(); };
  }

  function progress() {
    var pages = shownPages(), n = pages.length, cur = Math.min(state.idx, n - 1) + 1;
    var box = el('div', 'prog'), bar = el('div', 'bar'), fill = el('div', 'fill');
    fill.style.width = Math.round((cur - 1) / n * 100) + '%';
    bar.appendChild(fill); box.appendChild(bar);
    box.appendChild(el('span', '', Math.round((cur - 1) / n * 100) + '% 完了'));
    return box;
  }

  function renderQ(q, card) {
    var box = el('div', 'q'); var lt = el('label', 't', q.text); if (q.required) lt.appendChild(el('span', 'req', '必須')); box.appendChild(lt); q.box = box;
    if (q.note) box.appendChild(el('div', 'help', q.note));
    if (q.kind === 'single') {
      (q.choices || []).forEach(function (ch) {
        var lab = el('label', 'opt'), r = document.createElement('input'); r.type = 'radio'; r.name = 'q_' + q.id; r.value = ch;
        r.checked = state.ans[q.id] === ch;
        r.onchange = function () { state.ans[q.id] = ch; if (q.gate || state.def.blocks.some(function (b) { return b.hiddenWhen && b.hiddenWhen.id === q.id; })) show(true); };
        lab.appendChild(r); lab.appendChild(el('span', '', ch)); box.appendChild(lab);
      });
    } else if (q.kind === 'multi') {
      (q.choices || []).forEach(function (ch) {
        var lab = el('label', 'opt'), r = document.createElement('input'); r.type = 'checkbox'; r.value = ch;
        r.checked = (state.ans[q.id] || []).indexOf(ch) !== -1;
        r.onchange = function () {
          var cur = (state.ans[q.id] || []).filter(function (x) { return x !== ch; });
          if (r.checked) { cur = (q.exclusive && ch === q.exclusive) ? [ch] : cur.filter(function (x) { return x !== q.exclusive; }).concat([ch]); }
          state.ans[q.id] = cur; show(true);
        };
        lab.appendChild(r); lab.appendChild(el('span', '', ch)); box.appendChild(lab);
      });
    } else {
      var inp = q.kind === 'text' ? document.createElement('textarea') : document.createElement('input');
      if (q.kind !== 'text') { inp.type = 'text'; inp.inputMode = q.kind === 'age' ? 'numeric' : 'text'; }
      inp.value = state.ans[q.id] || ''; inp.autocomplete = 'off';
      inp.oninput = function () { state.ans[q.id] = inp.value; };
      box.appendChild(inp);
    }
    card.appendChild(box);
  }

  /** そのページの必須の設問(分岐で非表示のものを除く)に、未回答がないか。あれば、赤字で知らせて、false を返す */
  function pageOk(p) {
    var first = null;
    p.qs.forEach(function (q) {
      if (hidden(q) || !q.required || !q.box) return;
      var v = state.ans[q.id], empty = q.kind === 'multi' ? !(v && v.length) : (v === undefined || v === null || String(v).trim() === '');
      q.box.classList.toggle('bad', empty);
      var old = q.box.querySelector('.err'); if (old) old.parentNode.removeChild(old);
      if (empty) { var e = el('div', 'err', 'ご回答をお願いします'); q.box.appendChild(e); if (!first) first = q.box; }
    });
    if (first && first.scrollIntoView) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return !first;
  }

  /** keep=true: 画面の位置を保ったまま、選択に合わせて描き直す */
  function show(keep) {
    var y = window.pageYOffset || 0;
    var pages = shownPages();
    if (state.idx > pages.length - 1) state.idx = pages.length - 1;
    var p = pages[state.idx];
    app.innerHTML = '';
    app.appendChild(progress());
    var card = el('div', 'card');
    if (p.title) card.appendChild(el('h2', '', p.title));
    if (p.desc) card.appendChild(el('div', 'desc', p.desc));
    p.qs.filter(function (q) { return !hidden(q); }).forEach(function (q) { renderQ(q, card); });
    app.appendChild(card);
    var last = state.idx === pages.length - 1;
    var row = el('div', 'nav');
    if (state.idx > 0) { var back = el('button', 'btn ghost', '← もどる'); back.type = 'button'; back.onclick = function () { state.idx--; show(); window.scrollTo(0, 0); }; row.appendChild(back); }
    var next = el('button', 'btn', last ? (state.editing ? '修正を送信する' : '送信する') : 'つぎへ →'); next.type = 'button';
    next.onclick = function () { if (!pageOk(p)) return; if (last) submit(next); else { state.idx++; show(); window.scrollTo(0, 0); } };
    row.appendChild(next); app.appendChild(row);
    if (keep) window.scrollTo(0, y);
  }

  function submit(btn) {
    btn.disabled = true; btn.textContent = '送信しています…';
    var out = {};
    qs().forEach(function (q) { if (!hidden(q) && state.ans[q.id] !== undefined) out[q.id] = state.ans[q.id]; });
    google.script.run.withSuccessHandler(function (r) {
      if (r && r.ok) return chooser(r.options || [], r.edited ? 'ご回答を修正しました' : 'ご回答ありがとうございました');
      if (r && (r.expired || r.done)) { alert(r.message); return login(); }
      btn.disabled = false; btn.textContent = state.editing ? '修正を送信する' : '送信する'; alert((r && r.message) || '送信できませんでした。もう一度お試しください。');
    }).withFailureHandler(function () {
      btn.disabled = false; btn.textContent = state.editing ? '修正を送信する' : '送信する'; alert('通信できませんでした。もう一度お試しください。');
    }).surveySubmit(state.token, out);
  }

  function done() {
    app.innerHTML = '';
    var c = el('div', 'card');
    c.appendChild(el('div', 'ok', '✓'));
    c.appendChild(el('h2', '', 'ご回答ありがとうございました'));
    c.appendChild(el('div', 'desc', '回答を受け付けました。このページは、閉じて大丈夫です。次のアンケートの準備ができたら、メールでご案内します。'));
    app.appendChild(c); window.scrollTo(0, 0);
  }

  login();
}

