// ---------- 定義用ヘルパー ----------
function P_(title, opts) {
  opts = opts || {};
  return { type: 'page', title: title, conditional: !!opts.conditional, desc: opts.desc || '' };
}
function Q_(o) { o.type = 'q'; return o; }
function LK_(id, text, axis, purpose, o) {
  return Q_(Object.assign({ id: id, text: text, kind: 'single', scale: 'L4', axis: axis, purpose: purpose }, o || {}));
}
function FQ_(id, text, axis, purpose, o) {
  return Q_(Object.assign({ id: id, text: text, kind: 'single', scale: 'FREQ4', axis: axis, purpose: purpose }, o || {}));
}
function TX_(id, text, purpose, o) {
  return Q_(Object.assign({ id: id, text: text, kind: 'text', axis: AXIS.FREE, purpose: purpose }, o || {}));
}
function SG_(id, text, scaleKey, axis, purpose, o) {
  return Q_(Object.assign({ id: id, text: text, kind: 'single', scale: scaleKey, axis: axis, purpose: purpose }, o || {}));
}
function ID_() {
  return Q_({
    id: 'RID', kind: 'id', axis: AXIS.ID, system: true, required: true,
    text: '調査用ID(運営から届いた専用リンクで自動入力されます。変更しないでください)',
    purpose: '回答者の家庭を匿名IDで識別し、T0〜T2を紐づける'
  });
}
